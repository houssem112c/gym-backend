# Environment
NODE_ENV=production

# Server Port
PORT=3001

# Database URL (PostgreSQL)
# 
# Option 1: Supabase (FREE - Recommended)
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI with connection pooling)
# DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# Option 2: OVH Database (Paid)
# DATABASE_URL=postgresql://username:password@your-ovh-db-host:5432/gym_db?schema=public
#
# Option 3: Docker PostgreSQL on VPS (FREE)
# DATABASE_URL=postgresql://gymuser:password@localhost:5432/gym_db?schema=public
#
#DATABASE_URL=postgresql://username:password@host:5432/database?schema=public
DATABASE_URL=postgresql://gymurb_user:M4ca25fG2wf8IbChqF10GZ6RmBQd4Mt8@dpg-dbosb6e417fc7398qkp0-a.oregon-postgres.render.com/gymurb

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
JWT_REFRESH_EXPIRATION=7d

# Frontend URLs (for CORS)
# Replace with your OVH deployed admin panel URL
FRONTEND_URL=https://your-frontend-domain.com
ADMIN_URL=https://your-ovh-admin-url.com
CORS_ORIGIN=https://your-frontend-domain.com,https://your-ovh-admin-url.com

# Optional: File upload settings
MAX_FILE_SIZE=10mb

# Supabase Configuration (for file uploads)
# Get these from: Supabase Dashboard -> Project Settings -> API
# URL: Your project URL (e.g., https://xxxxx.supabase.co)
# Key: Use 'anon' public key for client-side or 'service_role' key for server-side
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Stripe
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Transactional email provider (required for production verification/reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
